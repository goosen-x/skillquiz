{
	"name": "skillquiz",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "pnpm@9.9.0",
	"browserslist": [
		"chrome >= 93",
		"edge >= 93",
		"firefox >= 92",
		"safari >= 15.4",
		"ios_saf >= 15.4",
		"not dead"
	],
	"scripts": {
		"dev": "next dev",
		"build": "pnpm validate:quizzes && next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"validate:quizzes": "tsx scripts/validate-quizzes.ts",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"jspdf": "^4.2.1",
		"lucide-react": "^0.561.0",
		"next": "^16.2.11",
		"next-themes": "^0.4.6",
		"pg": "^8.16.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^2.5.2",
		"unist-util-visit": "^5.0.0",
		"vaul": "^1.1.2",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@next/eslint-plugin-next": "^16.2.11",
		"@playwright/test": "^1.56.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/mdast": "^4.0.4",
		"@types/node": "^20.19.27",
		"@types/pg": "^8.20.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"pdf-parse": "^1.1.1",
		"postcss": "^8",
		"prettier": "^3.7.4",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0",
		"vitest": "^3.2.4"
	}
}
